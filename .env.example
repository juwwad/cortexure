# Environment variables example
# Copy this file to .env.local and fill in your actual values

# Contact form (components/Footer.tsx)
# The site is statically exported (`output: "export"`), so the form needs an
# external endpoint that accepts a JSON POST and allows CORS from this origin.
# Without NEXT_PUBLIC_CONTACT_ENDPOINT the form shows an error instead of a
# fake success message.
# NEXT_PUBLIC_CONTACT_ENDPOINT=https://formspree.io/f/your-form-id
# Fallback address shown when the form is not connected.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# Supabase Configuration (when ready to integrate)
# NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Add other environment variables below as needed
